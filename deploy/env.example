# Hostinger Docker Manager > Proje > Environment bölümüne bu değerleri girin.
# (SSH ile kuruyorsanız depo kök dizininde .env dosyası olarak kaydedin.)

# Alan adınız (www olmadan). DNS A kaydı VPS IP adresinize yönlenmiş olmalı.
DOMAIN=ornek-site.com

# Veritabanı adı (değiştirmeyin)
DB_NAME=shabnam

# Yönetici girişi (yalnızca veritabanında yönetici yoksa kullanılır)
ADMIN_EMAIL=erolsimsekg@gmail.com
ADMIN_PASSWORD=BURAYA-GUCLU-BIR-SIFRE

# Rastgele uzun bir metin (64 karakter). Üretmek için: openssl rand -hex 32
JWT_SECRET=BURAYA-RASTGELE-64-KARAKTER

# E-posta (SMTP) - teklif bildirimi ve şifre sıfırlama için
# Hostinger e-posta: smtp.hostinger.com / 465 / tam e-posta adresi / e-posta şifresi
# Gmail: smtp.gmail.com / 587 / gmail adresi / 16 haneli uygulama şifresi
EMAIL_FROM_NAME=Shabnam Elegant
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@ornek-site.com
SMTP_PASSWORD=e-posta-sifresi
SMTP_FROM=info@ornek-site.com

# Telegram bildirimleri (isteğe bağlı) - @BotFather'dan alınan bot anahtarı
TELEGRAM_BOT_TOKEN=
